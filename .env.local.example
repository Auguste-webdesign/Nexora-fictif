# ---------------------------------------------------------------------------
# Notification vendeur (Resend)
#
# Copiez ce fichier en `.env.local` puis remplissez les valeurs.
# `.env.local` n'est JAMAIS versionné (voir .gitignore) et ne doit jamais être
# partagé. Redémarrez `npm run dev` après toute modification.
# ---------------------------------------------------------------------------

# 1. Votre clé Resend, créée sur https://resend.com/api-keys
#    Elle commence par "re_". Ne la collez nulle part ailleurs que dans .env.local.
RESEND_API_KEY=

# 2. L'adresse qui reçoit les commandes.
#    Tant qu'aucun domaine n'est vérifié chez Resend, ce DOIT être l'adresse du
#    compte Resend lui-même : l'expéditeur de test n'accepte pas d'autre
#    destinataire.
NEXORA_SELLER_EMAIL=

# 3. Expéditeur (facultatif).
#    Laissez vide pour utiliser l'expéditeur de test de Resend, qui fonctionne
#    sans configuration de domaine. Pour envoyer depuis votre propre domaine,
#    vérifiez-le sur https://resend.com/domains puis indiquez par exemple :
#    NEXORA_MAIL_FROM="Nexora <commandes@votre-domaine.fr>"
NEXORA_MAIL_FROM=
